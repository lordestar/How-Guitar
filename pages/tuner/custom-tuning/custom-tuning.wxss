.page {
  min-height: 100vh;
  background: var(--tuner-bg);
  padding: var(--space-md) var(--space-md) var(--space-xl);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.section-title {
  font-size: var(--font-md);
  font-weight: 800;
  color: var(--tuner-text);
  margin-bottom: var(--space-md);
}

.tuning-name-input {
  width: 100%;
  height: 80rpx;
  background: var(--tuner-surface);
  border: 2rpx solid var(--tuner-border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--tuner-text);
  box-sizing: border-box;
  margin-bottom: var(--space-xl);
}
.tuning-name-input::placeholder {
  color: var(--tuner-text-dim);
}

.string-section {
  margin-bottom: var(--space-xs);
}

.string-row {
  display: flex;
  align-items: flex-start;
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--tuner-border);
}

.string-label {
  width: 110rpx;
  font-size: var(--font-sm);
  color: var(--tuner-text-dim);
  font-weight: 700;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.string-picker-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.string-slider {
  width: 100%;
}

.string-value {
  font-size: var(--font-xs);
  color: var(--tuner-text);
  display: flex;
  justify-content: space-between;
}
.string-note {
  font-weight: 700;
  color: var(--tuner-success);
}
.string-freq {
  color: var(--tuner-text-dim);
}

.string-warning {
  font-size: 18rpx;
  color: var(--accent);
  background: var(--tuner-danger-soft);
  border-left: 4rpx solid var(--accent);
  padding: 6rpx 12rpx;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  margin-top: var(--space-xs);
  display: none;
}
.string-warning.visible {
  display: block;
}

.string-warning-icon {
  font-size: var(--font-sm);
  margin-right: 4rpx;
}

.btn-row {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: var(--font-md);
  font-weight: 600;
}

.btn-cancel {
  background: transparent;
  border: 2rpx solid var(--tuner-border);
  color: var(--tuner-text-dim);
}

.btn-save {
  background: var(--accent);
  color: #FFF;
}

.btn-save.disabled {
  opacity: 0.35;
}
