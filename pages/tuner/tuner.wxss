/* 调音器 — 浅色模式（默认） */
.page { min-height: 100vh; background: #F5F3EE; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }

/* 自动切弦 */
.auto-switch-bar { display: flex; justify-content: center; padding: 12rpx 0 4rpx 0; }
.auto-switch-toggle { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 24rpx; border-radius: 24rpx; background: #FFF; border: 1rpx solid #E8E3DD; transition: all 0.2s; }
.auto-switch-toggle.on { border-color: #4CAF50; background: rgba(76,175,80,0.06); }
.auto-switch-toggle.off { border-color: #FF8844; background: rgba(255,136,68,0.06); }
.auto-switch-icon { font-size: 24rpx; line-height: 1; }
.auto-switch-label { font-size: 22rpx; color: #A09080; }

/* 进度条 */
.step-bar { display: flex; justify-content: center; gap: 12rpx; padding: 16rpx 32rpx; }
.step-dot { width: 72rpx; height: 72rpx; border-radius: 50%; background: #FFF; border: 2rpx solid #E8E3DD; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.step-dot.done { background: #4CAF50; border-color: #4CAF50; }
.step-dot.active { border-color: #D32F2F; box-shadow: 0 0 12rpx rgba(211,47,47,0.15); }
.step-num { font-size: 22rpx; font-weight: 700; color: #A09080; }
.step-dot.done .step-num { color: #fff; }
.step-dot.active .step-num { color: #D32F2F; }

/* 信息行 */
.info-row { display: flex; justify-content: center; align-items: baseline; gap: 16rpx; padding: 8rpx 32rpx; }
.info-name { font-size: 36rpx; font-weight: 800; color: #1A0E08; }
.info-target { font-size: 22rpx; color: #A09080; }

/* 状态标签 */
.status-tag { display: flex; justify-content: center; padding: 4rpx 0 12rpx 0; }
.status-tag text { font-size: 24rpx; font-weight: 600; padding: 4rpx 20rpx; border-radius: 12rpx; }
.status-tag.waiting text { color: #888; background: rgba(136,136,136,0.06); }
.status-tag.flat text { color: #E08040; background: rgba(224,128,64,0.08); }
.status-tag.sharp text { color: #D05050; background: rgba(208,80,80,0.08); }
.status-tag.near text { color: #5090C0; background: rgba(80,144,192,0.08); }
.status-tag.tuned text { color: #4CAF50; background: rgba(76,175,80,0.08); }

/* 仪表盘容器 */
.gauge-box { display: flex; justify-content: center; padding: 0 32rpx; }
.gauge-canvas { width: 520rpx; height: 420rpx; }

/* 频率行 */
.freq-row { display: flex; justify-content: center; align-items: baseline; gap: 6rpx; padding: 0 32rpx; }
.freq-val { font-size: 28rpx; font-weight: 700; color: #1A0E08; }
.freq-unit { font-size: 20rpx; color: #A09080; }
.note-row { display: flex; justify-content: center; align-items: baseline; gap: 10rpx; padding: 0 32rpx 8rpx 32rpx; }
.note-val { font-size: 24rpx; color: #A09080; }
.note-cents { font-size: 22rpx; font-weight: 600; }

/* 权限 */
.perm-box { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx; color: #A09080; font-size: 22rpx; }
.perm-btn { padding: 8rpx 32rpx; background: #D32F2F; color: #fff; border-radius: 8rpx; font-size: 22rpx; }

/* 底部按钮 */
.btn-row { display: flex; justify-content: center; gap: 12rpx; padding: 16rpx 32rpx; }
.str-btn { width: 72rpx; height: 56rpx; border-radius: 12rpx; background: #FFF; border: 1rpx solid #E8E3DD; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.str-btn text { font-size: 24rpx; font-weight: 700; color: #A09080; }
.str-btn.active { border-color: #D32F2F; background: rgba(211,47,47,0.04); }
.str-btn.active text { color: #D32F2F; }
.str-btn.done { border-color: #4CAF50; background: rgba(76,175,80,0.04); }
.str-btn.done text { color: #4CAF50; }

/* 重新开始 */
.restart-btn { text-align: center; padding: 12rpx 0; font-size: 24rpx; color: #A09080; }

/* 调音方案切换按钮 */
.tuning-switch-btn { position: fixed; right: 32rpx; bottom: 160rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: #FFF; border: 1rpx solid #E8E3DD; display: flex; align-items: center; justify-content: center; font-size: 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }

/* 遮罩 */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
.dialog { background: #FFF; border-radius: 20rpx; padding: 40rpx 32rpx; margin: 32rpx; max-width: 560rpx; text-align: center; }
.dialog-title { font-size: 32rpx; font-weight: 700; color: #1A0E08; margin-bottom: 16rpx; display: block; }
.dialog-body { font-size: 24rpx; color: #A09080; line-height: 1.6; margin-bottom: 24rpx; display: block; }
.dialog-actions { display: flex; gap: 16rpx; justify-content: center; }
.dialog-btn { padding: 12rpx 40rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; }
.dialog-btn-ok { background: linear-gradient(135deg, #4CAF50, #66BB6A); color: #fff; }
.dialog-btn-cancel { background: #F0EDE8; color: #A09080; }
.complete-icon { font-size: 56rpx; display: block; margin-bottom: 12rpx; }

/* 调音方案面板 */
.tuning-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.3); opacity: 0; pointer-events: none; transition: opacity 0.25s; z-index: 110; }
.tuning-overlay.active { opacity: 1; pointer-events: auto; }
.tuning-panel { position: absolute; bottom: 0; left: 0; right: 0; background: #FFF; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx 64rpx; transform: translateY(100%); transition: transform 0.3s; }
.tuning-panel.active { transform: translateY(0); }
.tuning-panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.tuning-panel-title { font-size: 28rpx; font-weight: 700; color: #1A0E08; }
.tuning-panel-close { font-size: 28rpx; color: #A09080; }
.tuning-panel-list { max-height: 400rpx; }
.tuning-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 16rpx; border-radius: 12rpx; margin-bottom: 8rpx; background: #F8F5F0; }
.tuning-item.active { border: 1rpx solid #4CAF50; }
.tuning-item-left { display: flex; flex-direction: column; }
.tuning-item-name { font-size: 26rpx; font-weight: 600; color: #1A0E08; }
.tuning-item-desc { font-size: 20rpx; color: #A09080; margin-top: 4rpx; }
.tuning-item-right { display: flex; gap: 12rpx; align-items: center; }
.tuning-item-check { color: #4CAF50; font-size: 24rpx; }
.tuning-item-delete { font-size: 24rpx; }
.tuning-panel-add { display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 20rpx; border-radius: 12rpx; background: rgba(76,175,80,0.04); margin-top: 8rpx; }
.tuning-add-icon { font-size: 28rpx; color: #4CAF50; }
.tuning-add-text { font-size: 24rpx; color: #4CAF50; }

/* ===== 暗色模式 ===== */
.page.dark-mode { background: #14142A; }
.dark-mode .auto-switch-toggle { background: #22223A; border-color: #333358; }
.dark-mode .auto-switch-label { color: #706878; }
.dark-mode .step-dot { background: #22223A; border-color: #333358; }
.dark-mode .step-num { color: #706878; }
.dark-mode .info-name { color: #F0EBE0; }
.dark-mode .info-target { color: #706878; }
.dark-mode .freq-val { color: #F0EBE0; }
.dark-mode .freq-unit { color: #706878; }
.dark-mode .note-val { color: #706878; }
.dark-mode .perm-box { color: #706878; }
.dark-mode .perm-btn { background: #FF6B6B; }
.dark-mode .str-btn { background: #22223A; border-color: #333358; }
.dark-mode .str-btn text { color: #706878; }
.dark-mode .str-btn.active { border-color: #FF6B6B; background: rgba(255,107,107,0.06); }
.dark-mode .str-btn.active text { color: #FF6B6B; }
.dark-mode .str-btn.done { border-color: #4CAF50; background: rgba(76,175,80,0.06); }
.dark-mode .str-btn.done text { color: #4CAF50; }
.dark-mode .restart-btn { color: #706878; }
.dark-mode .tuning-switch-btn { background: #22223A; border-color: #333358; }
.dark-mode .dialog { background: #22223A; }
.dark-mode .dialog-title { color: #F0EBE0; }
.dark-mode .dialog-body { color: #706878; }
.dark-mode .dialog-btn-cancel { background: #2E2E50; color: #706878; }
.dark-mode .tuning-panel { background: #22223A; }
.dark-mode .tuning-panel-title { color: #F0EBE0; }
.dark-mode .tuning-panel-close { color: #706878; }
.dark-mode .tuning-item { background: #1A1A30; }
.dark-mode .tuning-item-name { color: #F0EBE0; }
.dark-mode .tuning-item-desc { color: #706878; }
.dark-mode .tuning-panel-add { background: rgba(76,175,80,0.06); }
