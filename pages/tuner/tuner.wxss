.page {
  min-height: 100vh;
  background: #14142A;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.page.ready { background: #14142A; }

/* ===== 弹窗 ===== */
.overlay {
  position: fixed; top:0; left:0; right:0; bottom:0;
  background: rgba(0,0,0,0.6); display: flex;
  align-items: center; justify-content: center; z-index: 99;
}
.dialog {
  background: #222244; border-radius: 28rpx; padding: 40rpx 36rpx;
  width: 560rpx; border: 2rpx solid #333366;
}
.dialog-title { font-size: 34rpx; font-weight: 800; color: #F0EBE0; display: block; text-align: center; margin-bottom: 16rpx; }
.dialog-body { font-size: 26rpx; color: #A09888; line-height: 1.7; display: block; margin-bottom: 32rpx; }
.dialog-actions { display: flex; gap: 20rpx; flex-direction: column; }
.dialog-btn { height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; }
.dialog-btn-cancel { background: #333358; color: #A09888; }
.dialog-btn-ok { background: #FF6B6B; color: #FFF; }

/* ===== 主内容 ===== */
.main { width: 100%; max-width: 650rpx; padding: 20rpx 32rpx 40rpx; display: flex; flex-direction: column; align-items: center; }

/* ===== 进度条 ===== */
.step-bar { display: flex; gap: 0; width: 100%; margin-bottom: 16rpx; background: #1E1E3A; border-radius: 24rpx; padding: 8rpx 4rpx; border: 2rpx solid #2E2E50; }
.step-dot { flex: 1; display: flex; align-items: center; justify-content: center; height: 48rpx; border-radius: 16rpx; transition: all 0.2s; }
.step-dot.active { background: #FF6B6B; }
.step-dot.done { background: #3A9A5A; }
.step-num { font-size: 22rpx; font-weight: 800; color: #706868; }
.step-dot.active .step-num { color: #FFF; }
.step-dot.done .step-num { color: #FFF; }

/* ===== 弦信息 ===== */
.info-row { text-align: center; margin-bottom: 6rpx; }
.info-name { font-size: 30rpx; font-weight: 800; color: #F0EBE0; display: block; }
.info-target { font-size: 20rpx; color: #706868; margin-top: 2rpx; display: block; }

/* ===== 状态标签 ===== */
.status-tag { padding: 6rpx 24rpx; border-radius: 18rpx; font-size: 22rpx; font-weight: 600; margin-bottom: 12rpx; text-align: center; }
.status-tag.waiting { color: #706868; background: #1E1E3A; }
.status-tag.detecting { color: #8888CC; background: #1E1E44; }
.status-tag.flat { color: #FF8844; background: #2A1E18; }
.status-tag.sharp { color: #FF6B6B; background: #2A1818; }
.status-tag.near { color: #66BBFF; background: #18223A; }
.status-tag.tuned { color: #4CAF50; background: #182A1A; }

/* ===== Canvas 仪表盘 ===== */
.gauge-box { width: 560rpx; height: 560rpx; margin: 0 auto 8rpx; }
.gauge-canvas { width: 560rpx; height: 560rpx; }

/* ===== 频率显示 ===== */
.freq-row { text-align: center; margin-bottom: 4rpx; }
.freq-val { font-size: 52rpx; font-weight: 800; color: #F0EBE0; font-variant-numeric: tabular-nums; display: inline; }
.freq-unit { font-size: 22rpx; color: #706868; margin-left: 4rpx; }
.note-row { text-align: center; margin-bottom: 16rpx; }
.note-val { font-size: 28rpx; font-weight: 700; color: #706868; display: block; }
.note-row.flat .note-val { color: #FF8844; }
.note-row.sharp .note-val { color: #FF6B6B; }
.note-row.tuned .note-val { color: #4CAF50; }
.note-row.near .note-val { color: #66BBFF; }
.note-cents { font-size: 22rpx; font-weight: 600; color: #555; display: block; margin-top: 2rpx; }
.note-row.flat .note-cents { color: #FF8844; }
.note-row.sharp .note-cents { color: #FF6B6B; }
.note-row.tuned .note-cents { color: #4CAF50; }
.note-row.near .note-cents { color: #66BBFF; }

/* ===== 权限提示 ===== */
.perm-box { display: flex; flex-direction: column; align-items: center; padding-top: 60rpx; gap: 20rpx; }
.perm-box text { font-size: 26rpx; color: #A09888; }
.perm-btn { padding: 18rpx 56rpx; background: #FF6B6B; color: #FFF; border-radius: 36rpx; font-size: 26rpx; font-weight: 600; }

/* ===== 选弦按钮 ===== */
.btn-row { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.str-btn { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; background: #1E1E3A; border-radius: 50%; border: 2rpx solid #2E2E50; transition: all 0.15s; }
.str-btn.active { border-color: #FF6B6B; transform: scale(1.12); }
.str-btn.done { background: #3A9A5A; border-color: #3A9A5A; }
.str-btn text { font-size: 24rpx; font-weight: 800; color: #706868; }
.str-btn.active text { color: #FF6B6B; }
.str-btn.done text { color: #FFF; }

/* ===== 重新开始 ===== */
.restart-btn { height: 70rpx; width: 100%; display: flex; align-items: center; justify-content: center; background: #1E1E3A; border-radius: 35rpx; border: 2rpx solid #2E2E50; font-size: 24rpx; font-weight: 600; color: #A09888; }
.restart-btn:active { opacity: 0.7; }

/* ===== 完成弹窗 ===== */
.complete-dialog { text-align: center; }
.complete-icon { font-size: 100rpx; display: block; margin-bottom: 12rpx; }
