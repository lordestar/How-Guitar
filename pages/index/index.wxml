<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <view class="hero">
    <view class="hero-row">
      <view class="dark-btn" bindtap="onToggleDarkMode">
        <text class="dark-btn-icon">{{darkMode ? '☀️' : '🌙'}}</text>
      </view>
    </view>
    <text class="hero-title">如何吉他</text>
    <text class="hero-desc">你的吉他学习助手</text>
  </view>

  <view class="cards">
    <view class="card" bindtap="onGoChord" hover-class="card-press">
      <view class="card-dot dot-chord"></view>
      <view class="card-body">
        <text class="card-title">和弦指法</text>
        <text class="card-desc">查阅指板按法 / 试听发声</text>
      </view>
    </view>
    <view class="card" bindtap="onGoTuner" hover-class="card-press">
      <view class="card-dot dot-tuner"></view>
      <view class="card-body">
        <text class="card-title">调音器</text>
        <text class="card-desc">实时音高检测 / 逐弦调准</text>
      </view>
    </view>
  </view>

  <view class="fav-section" wx:if="{{favoriteChords.length > 0}}">
    <view class="section-head">
      <view class="head-line"></view>
      <text class="head-text">收藏</text>
    </view>
    <scroll-view class="fav-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{favoriteChords}}"
        wx:for-item="fav"
        wx:for-index="i"
        wx:key="key"
        class="fav-pill"
        bindtap="onSelectFavorite"
        data-key="{{fav.key}}"
      >
        <text class="pill-name">{{fav.chordName}}</text>
        <text class="pill-type">{{fav.typeName}}</text>
      </view>
    </scroll-view>
  </view>
</view>
