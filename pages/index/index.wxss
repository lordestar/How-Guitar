/* pages/index/index.wxss — 首页 */
.container {
  padding: 0 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  transition: background 0.25s ease;
}

/* ===== Hero ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 40rpx;
}

.hero-row {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.dark-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border, #E8E3DD);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  box-shadow: 0 2rpx 12rpx rgba(44, 24, 16, 0.04);
}

.dark-btn:active {
  transform: scale(0.94);
  background: var(--surface);
}

.dark-btn-icon {
  font-size: 28rpx;
  line-height: 1;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  line-height: 1.15;
  transition: color 0.25s ease;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text-tertiary, #B8A898);
  margin-top: 14rpx;
  letter-spacing: 4rpx;
  line-height: 1;
  transition: color 0.25s ease;
}

/* ===== Feature Cards ===== */
.cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 44rpx;
}

.card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 28rpx 48rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--card-border, #ECEAE6);
  box-shadow: 0 1rpx 4rpx rgba(44, 24, 16, 0.03);
  transition: all 0.2s ease;
}

.card-press {
  transform: scale(0.985);
  box-shadow: 0 2rpx 16rpx rgba(44, 24, 16, 0.06);
  border-color: transparent;
}

.card-dot {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-chord {
  background: #D32F2F;
}

.dot-tuner {
  background: #2E7D32;
}

.card-body {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1;
  transition: color 0.25s ease;
}

.card-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.3;
  transition: color 0.25s ease;
}

/* ===== Favorites ===== */
.fav-section {
  flex: 1;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.head-line {
  width: 24rpx;
  height: 2rpx;
  background: var(--accent, #D32F2F);
  border-radius: 1rpx;
}

.head-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  transition: color 0.25s ease;
}

.fav-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.fav-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 88rpx;
  margin-right: 12rpx;
  background: var(--accent-light, #FFF0F0);
  border-radius: 16rpx;
  border: 1rpx solid rgba(211, 47, 47, 0.08);
  transition: all 0.18s ease;
}

.fav-pill:active {
  transform: scale(0.94);
}

.pill-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.2;
  transition: color 0.25s ease;
}

.pill-type {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  transition: color 0.25s ease;
}
