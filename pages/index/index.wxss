.container {
  padding: 0 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  transition: background 0.2s;
}

/* ===== 顶部品牌区 ===== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 12rpx;
}

.hero-icon {
  font-size: 60rpx;
  margin-bottom: 14rpx;
  filter: drop-shadow(var(--hero-icon-shadow));
  transition: filter 0.2s;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--hero-title, #1A0E08);
  letter-spacing: 2rpx;
  transition: color 0.2s;
}

.hero-sub {
  font-size: 24rpx;
  color: var(--hero-subtitle, #A09080);
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
  transition: color 0.2s;
}

/* ===== 暗色模式切换 ===== */
.dark-toggle {
  display: flex;
  justify-content: center;
  padding: 6rpx 0 28rpx;
}

.dark-toggle text {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border, transparent);
  box-shadow: var(--card-shadow);
  transition: all 0.2s;
}

.dark-toggle:active {
  opacity: 0.6;
}

/* ===== 功能入口卡片 ===== */
.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 22rpx;
  background: var(--card-bg);
  border: 2rpx solid var(--card-border, transparent);
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.card-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.card-chord .feature-icon {
  background: var(--accent-light, #FFF0F0);
}

.card-tuner .feature-icon {
  background: rgba(46, 125, 50, 0.1);
}

.feature-info {
  flex: 1;
  margin-left: 18rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #2C1810);
  display: block;
  transition: color 0.2s;
}

.feature-desc {
  font-size: 22rpx;
  color: var(--text-secondary, #A09080);
  margin-top: 4rpx;
  display: block;
  line-height: 1.4;
  transition: color 0.2s;
}

.feature-arrow {
  font-size: 32rpx;
  color: var(--text-light, #C0B0A0);
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 收藏夹 ===== */
.favorites-section {
  margin-bottom: 24rpx;
}

.fav-header {
  margin-bottom: 14rpx;
}

.fav-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  transition: color 0.2s;
}

.fav-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.fav-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 86rpx;
  margin-right: 14rpx;
  background: var(--card-bg);
  border-radius: 18rpx;
  border: 2rpx solid var(--card-border, transparent);
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.fav-chip:active {
  transform: scale(0.92);
}

.fav-chip-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.3;
  transition: color 0.2s;
}

.fav-chip-desc {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
  transition: color 0.2s;
}
