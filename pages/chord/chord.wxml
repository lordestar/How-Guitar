<view class="container {{darkMode ? 'dark-mode' : ''}}">
  <view class="card">
    <view class="card-header">
      <text class="card-title">和弦选择</text>
      <text class="card-badge">{{selectedRoot}}{{chordTypes[selectedTypeIndex].key === 'major' ? '' : chordTypes[selectedTypeIndex].key}}</text>
    </view>

    <view class="section">
      <text class="section-label">根音</text>
      <view class="root-grid">
        <view
          wx:for="{{rootNotes}}"
          wx:for-item="note"
          wx:for-index="i"
          wx:key="*this"
          class="root-btn {{selectedRootIndex === i ? 'active' : ''}}"
          bindtap="selectRoot"
          data-index="{{i}}"
        >
          <text>{{note}}</text>
          <view class="root-indicator"></view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-label">类型</text>
      <scroll-view class="type-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{chordTypes}}"
          wx:for-item="type"
          wx:for-index="i"
          wx:key="key"
          class="type-chip {{selectedTypeIndex === i ? 'active' : ''}}"
          bindtap="selectType"
          data-index="{{i}}"
        >
          <view class="type-indicator"></view>
          <text class="type-name">{{type.name}}</text>
          <text class="type-key">{{type.key}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="note-preview" wx:if="{{previewNotes}}">
    <text class="note-preview-label">组成音</text>
    <view class="note-pills">
      <text wx:for="{{previewNotesArray}}" wx:for-item="n" wx:for-index="i" wx:key="*this" class="note-pill {{i === 0 ? 'note-pill-root' : ''}}">{{n}}</text>
    </view>
  </view>
  <view class="error-msg" wx:if="{{errorMsg}}">
    <text>{{errorMsg}}</text>
  </view>

  <button class="generate-btn btn-gradient" bindtap="onGenerate" loading="{{isLoading}}">
    <text>{{isLoading ? '计算中...' : '查看指法'}}</text>
  </button>

  <view style="height: 20rpx;"></view>
</view>
