.container {
  padding: 0 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  transition: background 0.2s;
}

.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
  margin-bottom: 22rpx;
  border: 2rpx solid var(--card-border, transparent);
  box-shadow: var(--card-shadow);
  transition: all 0.2s;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-primary);
  transition: color 0.2s;
}

.card-badge {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--accent);
  background: var(--accent-light);
  padding: 8rpx 22rpx;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.section {
  margin-bottom: 20rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  display: block;
  transition: color 0.2s;
}

.root-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.root-btn {
  width: calc(25% - 9rpx);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--divider);
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  overflow: hidden;
  transition: all 0.15s;
}

.root-btn.active {
  background: var(--accent-light);
  border-color: transparent;
  box-shadow: none;
  transform: none;
}

.root-btn.active text {
  color: var(--accent);
}

.root-indicator {
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.root-btn.active .root-indicator {
  opacity: 1;
}

.root-btn:active {
  transform: scale(0.93);
}

.type-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.type-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 94rpx;
  margin-right: 16rpx;
  min-width: 120rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  position: relative;
  overflow: hidden;
  transition: all 0.15s;
}

.type-chip.active {
  border-color: transparent;
  background: var(--accent-light);
  transform: none;
}

.type-chip:active {
  transform: scale(0.92);
}

.type-indicator {
  position: absolute;
  left: 0;
  top: 15%;
  bottom: 15%;
  width: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.type-chip.active .type-indicator {
  opacity: 1;
}

.type-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
  transition: color 0.2s;
}

.type-chip.active .type-name {
  color: var(--accent);
}

.type-key {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  transition: color 0.2s;
}

.type-chip.active .type-key {
  color: var(--accent);
}

.note-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
  border: 2rpx solid var(--card-border, transparent);
  box-shadow: var(--card-shadow);
  transition: all 0.2s;
}

.note-preview-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  transition: color 0.2s;
}

.note-pills {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.note-pill {
  background: var(--accent-light);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-md);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.note-pill-root {
  background: var(--accent);
  color: #FFF;
}

.error-msg {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  background: var(--accent-light);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--accent);
  text-align: center;
  transition: all 0.2s;
}

.generate-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  background: var(--btn-primary-bg, linear-gradient(135deg, #D32F2F, #F57C00));
  color: #FFF;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.2), 0 8rpx 32rpx rgba(211, 47, 47, 0.15);
  margin-top: 4rpx;
  transition: all 0.2s;
}

.generate-btn:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(211, 47, 47, 0.15), 0 4rpx 16rpx rgba(211, 47, 47, 0.1);
}
