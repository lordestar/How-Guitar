.container {
  padding: 24rpx 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--page-bg);
  transition: background 0.2s;
}

.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.header-left {
  flex: 1;
}

.header-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.action-icon-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  transition: all 0.2s;
}

.action-icon-btn:active {
  transform: scale(0.8);
}

.fav-heart {
  font-size: 48rpx;
  color: var(--text-tertiary);
  transition: all 0.2s;
}

.action-icon-btn.fav-active .fav-heart {
  color: var(--accent);
  transform: scale(1.15);
}

.chord-name {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  transition: color 0.2s;
}

.chord-notes-pills {
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
  margin-top: var(--space-xs);
}

.notes-pill {
  background: var(--accent-light);
  color: var(--accent);
  font-size: var(--font-sm);
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.notes-pill-root {
  background: var(--accent);
  color: #FFF;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 14rpx 0 12rpx;
}

.nav-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-btn {
  width: 68rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border-radius: 30rpx;
  font-size: 36rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.nav-btn:active {
  transform: scale(0.88);
}

.nav-info {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  min-width: 60rpx;
  text-align: center;
  transition: color 0.2s;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 32rpx;
  background: var(--play-btn-bg);
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFF;
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.2), 0 8rpx 24rpx rgba(211, 47, 47, 0.1);
  transition: all 0.2s;
}

.play-btn:active {
  transform: scale(0.94);
}

.play-btn.playing {
  background: var(--play-btn-active-bg);
  box-shadow: var(--play-btn-active-shadow);
  animation: playPulse 1.5s ease-in-out infinite;
}

@keyframes playPulse {
  0%, 100% {
    box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.2);
  }
  50% {
    box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.4);
  }
}

.fingering-title-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 6rpx;
}

.fingering-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 6rpx 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-light);
  border-radius: 20rpx;
  transition: all 0.2s;
}

.fingering-title-bordered {
  border: 2rpx solid var(--accent-light);
}

.chord-info-card {
  background: var(--card-bg);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  border-left: 8rpx solid var(--accent);
  transition: all 0.2s;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row-multi {
  flex-wrap: wrap;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  margin-right: 12rpx;
}

.info-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  width: 120rpx;
  flex-shrink: 0;
  line-height: 1.5;
  transition: color 0.2s;
}

.info-value {
  font-size: 24rpx;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.5;
  transition: color 0.2s;
}

.info-prog {
  font-family: 'Menlo', 'Courier New', monospace;
  font-weight: 500;
  color: var(--accent);
  background: var(--accent-light);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.info-song {
  font-style: italic;
}

.info-divider-dashed {
  border-top: 2rpx dashed var(--divider);
  margin: 16rpx 0;
}

.info-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  transition: color 0.2s;
}

.string-table {
  background: var(--card-bg);
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.2s;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  border-bottom: 2rpx solid var(--divider);
  transition: border-color 0.2s;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row-alt {
  background: var(--surface);
}

.table-header {
  background: var(--table-header-bg);
  font-weight: 600;
  font-size: 22rpx;
  color: var(--table-header-color);
  transition: all 0.2s;
}

.col-string {
  width: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--table-color);
  transition: color 0.2s;
}

.col-note {
  width: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--table-note-color);
  transition: color 0.2s;
}

.col-note.chord-note {
  color: var(--accent);
}

.col-note.muted {
  color: var(--table-note-muted);
}

.col-fret {
  width: 80rpx;
  font-size: 24rpx;
  color: var(--table-fret-color);
  transition: color 0.2s;
}

.col-status {
  flex: 1;
  font-size: 22rpx;
  color: var(--table-status-color);
  text-align: right;
  transition: color 0.2s;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 8rpx;
  vertical-align: middle;
}

.status-dot.status-muted {
  background: var(--accent);
}

.status-dot.status-open {
  background: var(--tuner-success, #4CAF50);
}

.status-dot.status-fretted {
  background: var(--accent-secondary, #F57C00);
}

.action-buttons {
  margin-top: 6rpx;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  color: #FFF;
  background: var(--save-btn-bg);
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.2), 0 8rpx 32rpx rgba(211, 47, 47, 0.15);
  transition: all 0.2s;
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-gradient {
  background: var(--btn-primary-bg);
  box-shadow: var(--btn-primary-shadow);
}
