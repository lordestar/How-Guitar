.container {
  padding: 24rpx 24rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--page-bg);
  transition: background 0.2s;
}

/* 结果头部 */
.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.header-left {
  flex: 1;
}

.header-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.action-icon-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: var(--text-light);
  border-radius: 50%;
  transition: all 0.15s;
}

.action-icon-btn:active {
  transform: scale(0.8);
}

.action-icon-btn.fav-active {
  color: var(--accent);
}

.chord-name {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
  transition: color 0.2s;
}

.chord-notes {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
  transition: color 0.2s;
}

/* ===== 操作栏 ===== */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 14rpx 0 12rpx;
}

.nav-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-btn {
  width: 68rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg);
  border-radius: 30rpx;
  font-size: 36rpx;
  color: var(--text-primary);
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.nav-btn:active {
  transform: scale(0.88);
}

.nav-info {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  min-width: 60rpx;
  text-align: center;
  transition: color 0.2s;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 32rpx;
  background: var(--play-btn-bg);
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFF;
  box-shadow: var(--play-btn-shadow);
  transition: all 0.2s;
}

.play-btn:active {
  transform: scale(0.94);
}

.play-btn.playing {
  background: var(--play-btn-active-bg);
  box-shadow: var(--play-btn-active-shadow);
}

/* ===== 指法名称胶囊 ===== */
.fingering-title-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 6rpx;
}

.fingering-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 6rpx 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-light);
  border-radius: 20rpx;
  transition: all 0.2s;
}

/* ===== 和弦说明卡片 ===== */
.chord-info-card {
  background: var(--card-bg);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  border-left: 8rpx solid var(--accent);
  transition: all 0.2s;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.info-row-multi {
  flex-wrap: wrap;
}

.info-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  width: 120rpx;
  flex-shrink: 0;
  line-height: 1.5;
  transition: color 0.2s;
}

.info-value {
  font-size: 24rpx;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.5;
  transition: color 0.2s;
}

.info-prog {
  font-family: 'Courier New', monospace;
  font-weight: 500;
  color: var(--accent);
  background: var(--accent-light);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.info-song {
  color: #2E7D32;
}

.info-divider {
  height: 2rpx;
  background: var(--divider);
  margin: 16rpx 0;
  transition: background 0.2s;
}

.info-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  transition: color 0.2s;
}

/* ===== 弦位详情表 ===== */
.string-table {
  background: var(--card-bg);
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  transition: all 0.2s;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  border-bottom: 2rpx solid var(--divider);
  transition: border-color 0.2s;
}

.table-row:last-child {
  border-bottom: none;
}

.table-header {
  background: var(--table-header-bg);
  font-weight: 600;
  font-size: 22rpx;
  color: var(--table-header-color);
  transition: all 0.2s;
}

.col-string {
  width: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--table-color);
  transition: color 0.2s;
}

.col-note {
  width: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--table-note-color);
  transition: color 0.2s;
}

.col-note.chord-note {
  color: var(--accent);
}

.col-note.muted {
  color: var(--table-note-muted);
}

.col-fret {
  width: 80rpx;
  font-size: 24rpx;
  color: var(--table-fret-color);
  transition: color 0.2s;
}

.col-status {
  flex: 1;
  font-size: 22rpx;
  color: var(--table-status-color);
  text-align: right;
  transition: color 0.2s;
}

/* 按钮 */
.action-buttons {
  margin-top: 6rpx;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  color: #FFF;
  background: var(--save-btn-bg);
  box-shadow: 0 4rpx 16rpx rgba(211, 47, 47, 0.2);
  transition: all 0.2s;
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
