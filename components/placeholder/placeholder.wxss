.placeholder-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border-radius: 18rpx;
  border: 2rpx solid var(--card-border);
  box-shadow: var(--card-shadow);
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.placeholder-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.placeholder-icon {
  font-size: 52rpx;
}

.placeholder-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: color 0.2s;
}
