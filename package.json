{
  "name": "how-guitar",
  "version": "1.0.9",
  "description": "如何吉他 - 微信小程序：吉他和弦查询、指板可视化、和弦试听、吉他调音",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern .git",
    "format": "prettier --write \"**/*.js\" \"**/*.json\" \"**/*.wxml\" \"**/*.wxss\"",
    "format:check": "prettier --check \"**/*.js\" \"**/*.json\" \"**/*.wxml\" \"**/*.wxss\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.4.2",
    "prettier": "^3.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js"
    ]
  }
}
